{
  "manifest_version": 3,
  "name": "focus-pet",
  "description": "시간 도둑 앞에서 화내는 펫 — 할 일 마감과 도둑맞은 시간을 보고 점점 화를 내는 크롬 확장 프로그램",
  "version": "0.1.0",
  "action": {
    "default_title": "focus-pet",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/calm-16.png",
      "32": "icons/calm-32.png",
      "48": "icons/calm-48.png",
      "128": "icons/calm-128.png"
    }
  },
  "icons": {
    "16": "icons/calm-16.png",
    "32": "icons/calm-32.png",
    "48": "icons/calm-48.png",
    "128": "icons/calm-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "fonts/Galmuri11.woff2"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  }
}
